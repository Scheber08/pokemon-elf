{
  // Cloudflare Worker mit Static Assets: dist/ (Vite-Build) + API unter /api/* (worker/ → server/).
  // Deploy: Workers Builds (Git) oder `npm run deploy:cf`. Lokal: `npm run dev:cf`.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss zum Namen des Workers im Cloudflare-Dashboard passen.
  "name": "pokemon-elf",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep-Links wie /taeglich liefern index.html (React Router übernimmt)
    "not_found_handling": "single-page-application",
    // Nur API-Aufrufe und Liga-Seiten (Link-Vorschau, server/preview.ts) wecken den Worker –
    // alles andere kommt direkt aus dem Cache
    "run_worker_first": ["/api/*", "/draft/*"]
  },
  // Ohne database_id legt Wrangler die D1-Datenbank beim ersten Deploy selbst an.
  // Die Tabellen erstellt der Server beim ersten Aufruf (server/schema.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokemon-elf",
      "migrations_dir": "migrations"
    }
  ],
  // Online-Draft: ein Durable Object pro Liga (server/draftRoom.ts, exportiert in worker/index.ts).
  // SQLite-basierte Durable Objects laufen auch im Workers-Free-Plan.
  "durable_objects": {
    "bindings": [{ "name": "DRAFTS", "class_name": "DraftRoom" }]
  },
  // Migrationen wendet nur `wrangler deploy` (main) an – `wrangler versions upload` (Branch-Builds)
  // scheitert, solange eine aussteht (README → Deploy auf Cloudflare → Hinweise).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DraftRoom"] }],
  "observability": { "enabled": true }
}
