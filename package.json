{
  "name": "pokemon-elf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pokémon Elf – Lineup Builder: Fußball-Aufstellungen aus Pokémon",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "dev:cf": "npm run build && wrangler dev --port 8788",
    "deploy:cf": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
